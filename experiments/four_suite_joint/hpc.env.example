export FOUR_SUITE_LEROBOT_ROOT=/scratch/REPLACE_USER/libero40/hf/hub/datasets--physical-intelligence--libero/snapshots/a4336d589d589045d1c56423ffdf3b88a0e19b1f
export FOUR_SUITE_ANNOTATION_ROOT=/scratch/REPLACE_USER/libero40/assets/annotation
